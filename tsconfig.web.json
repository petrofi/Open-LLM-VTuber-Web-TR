{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "composite": false,
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "src/renderer/src/*"
      ],
      "@framework/*": [
        ".types/sdk/Framework/src/*"
      ],
      "@cubismsdksamples/*": [
        ".types/sdk/src/*"
      ]
    }
  },
  "include": [
    "src/renderer/src/**/*.ts",
    "src/renderer/src/**/*.tsx",
    "src/renderer/src/**/*.d.ts"
  ]
}
